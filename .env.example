# Existing backend (public configuration; RLS protects data)
NEXT_PUBLIC_INSFORGE_URL=
NEXT_PUBLIC_INSFORGE_ANON_KEY=

# Assistant: server-only settings. Base URL includes the provider's API prefix.
# Admin setup storage (keep both server-only; never use NEXT_PUBLIC_):
INSFORGE_API_KEY=
# Generate once with: openssl rand -hex 32. Preserve across redeploys.
ASSISTANT_SETTINGS_ENCRYPTION_KEY=

# Optional fallback when no settings are saved in the admin panel.
# OpenAI: https://api.openai.com/v1
# OpenRouter: https://openrouter.ai/api/v1
# The selected model must support Chat Completions function/tool calling.
ASSISTANT_BASE_URL=
ASSISTANT_MODEL=
ASSISTANT_API_KEY=
